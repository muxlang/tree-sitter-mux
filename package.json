{
  "name": "tree-sitter-mux",
  "version": "0.6.0",
  "private": true,
  "description": "Quality tooling for the Mux Tree-sitter grammar",
  "scripts": {
    "check": "npm run lint && npm run format:check && npm run samples",
    "format": "prettier --write 'eslint.config.js' 'scripts/**/*.js' 'package.json' 'tree-sitter.json'",
    "format:check": "prettier --check 'eslint.config.js' 'scripts/**/*.js' 'package.json' 'tree-sitter.json'",
    "lint": "eslint grammar.js --max-warnings 0",
    "samples": "node scripts/check-samples.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "prettier": "^3.6.2"
  }
}
